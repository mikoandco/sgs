{
  "name": "sgs-crm-backend",
  "version": "1.0.0",
  "description": "CRM Commercial Solution GS - Backend API",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "prisma generate && tsc",
