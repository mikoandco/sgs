# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sgs_crm

# JWT
JWT_SECRET=votre-secret-jwt-super-securise

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Backend URL (for webhooks)
BACKEND_URL=http://localhost:3001

# Google Calendar OAuth (optional - for bidirectional sync)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/google/callback
GOOGLE_WEBHOOK_URL=https://your-backend.railway.app/api/calendar/google/webhook

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
